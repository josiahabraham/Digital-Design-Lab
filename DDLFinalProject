int inBounds(int r, int c){
	return (r >= 0 && r < SIZE && c >= 0 && c < SIZE);
}

void newGame(void){
	for (int r = 0; r < SIZE; r++){
		for (int c = 0; c < SIZE; c++){
			board[r][c] = 0;
			king[r][c] = 0;
			if ((r + c) & 1){
				if (r < 2){
					board[r][c] = 2;
				}
				else if (r >= SIZE - 2){
					board[r][c] = 1;
				}
			}
		}
	}
}


int moveType(int player, int r, int c, int dr, int dc){
	int forward = (player == 1) ? -1 : 1;     //player 1 moves up, player 2 moves down
    int opponent = (player == 1) ? 2 : 1;
    if (board[r][c] != player){
    	return 0;
    }
    if (!king[r][c] && dr != forward){
    	return 0;    //only kings can go backwards
    }
    int r1 = r + dr;
    int c1 = c + dc;
    if (!inBounds(r1, c1)){
    	return 0;
    }
    if (board[r1][c1] == 0){
    	return 1;
    }
    if (board[r1][c1] == opponent){
    	int r2 = r1 + dr;
    	int c2 = c1 + dc;
    	if (inBounds(r2, c2) && board[r2][c2] == 0){
    		return 2;
    	}
    }
    return 0;
}

int hasJump(int player, int r, int c){
	for (int dr = -1; dr <= 1; dr += 2){
		for (int dc = -1; dc <= 1; dc += 2){
			if (moveType(player, r, c, dr, dc) == 2){
				return 1;
			}
		}
	}
	return 0;
}

int hasAnyMove(int player){
	for (int r = 0; r < SIZE; r++){
		for (int c = 0; c < SIZE; c++){
			for (int dr = -1; dr <= 1; dr += 2){
				for (int dc = -1; dc <= 1; dc += 2){
					if (moveType(player, r, c, dr, dc) != 0){
						return 1;
					}
				}
			}
		}
	}
	return 0;
}

int doMove(int player, int r, int c, int dr, int dc){
	int type = moveType(player, r, c, dr, dc);
	if (type == 0){
		return 0;
	}
	int step = (type == 2) ? 2 : 1;
	int nr = r + dr * step;
	int nc = c + dc * step;
	board[nr][nc] = player;
	king[nr][nc] = king[r][c];
	board[r][c] = 0;
	king[r][c] = 0;
	if (type == 2){
		board[r + dr][c + dc] = 0; 
		king[r + dr][c + dc] = 0;
	}
	if ((player == 1 && nr == 0) || (player == 2 && nr == SIZE - 1)){
		king[nr][nc] = 1;     
	}
	selR = nr;
	selC = nc;
	curR = nr;
	curC = nc;
	drawCell(r, c);
	if (type == 2){
		drawCell(r + dr, c + dc);
	}
	drawCell(nr, nc);
	return type;
}

void moveCursor(char key){
	int oldR = curR;
	int oldC = curC;
	if (key == 'A' && curR > 0){
		curR--;
	}
	else if (key == 'B' && curR < SIZE - 1){
		curR++;
	}
	else if (key == 'C' && curC > 0){
		curC--;
	}
	else if (key == 'D' && curC < SIZE - 1){
		curC++;
	}
	if (oldR != curR || oldC != curC){
		drawCell(oldR, oldC);
		drawCell(curR, curC);
	}
}

