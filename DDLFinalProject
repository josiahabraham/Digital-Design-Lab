void wait_ticks(int ticks){
	for (volatile int count = 0; count < ticks; count++){
		// do nothing
	}
}

void setOutput(volatile struct GPIOstruct *port, int bit){
	port->MODER &= ~(3u << (bit * 2));
	port->MODER |= (1u << (bit * 2));
}

void setPullup(volatile struct GPIOstruct *port, int bit){
	port->MODER &= ~(3u << (bit * 2));
	port->PUPDR &= ~(3u << (bit * 2));
	port->PUPDR |= (1u << (bit * 2));
}

void setAltFunc(volatile struct GPIOstruct *port, int bit){
	port->MODER &= ~(3u << (bit * 2));
	port->MODER |= (2u << (bit * 2));
	port->OSPEEDR |= (3u << (bit * 2));
	// AF0 is the reset value in AFRL, which is what SPI1 uses on PA5/PA7
}

void pinHigh(volatile struct GPIOstruct *port, int bit){
	port->BSRR = (1u << bit);
}

void pinLow(volatile struct GPIOstruct *port, int bit){
	port->BSRR = (1u << (bit + 16));
}

int readPin(volatile struct GPIOstruct *port, int bit){
	return (port->IDR >> bit) & 1;
}

/* ------------------------------- SPI --------------------------------- */
void spiInit(void){
	RCC_APBENR2 |= RCC_SPI1EN;
	SPI1->CR1 = 0;
	SPI1->CR1 = (1u << 2) | (1u << 8) | (1u << 9);   // master, SSM, SSI, mode 0, fPCLK/2
	SPI1->CR2 = (7u << 8) | (1u << 12);              // 8-bit frames, FRXTH
	SPI1->CR1 |= (1u << 6);                          // SPE
}

void spiWrite(int b){
	while (!(SPI1->SR & (1u << 1)));  //wait
	SPI1->DR = b; 
}

void spiWait(void){
	while (!(SPI1->SR & (1u << 1)));  //TXE
	while (SPI1->SR & (1u << 7));  //BSY
}


char scanKey(void){
	char found = 0;
	for (int c = 0; c < 4; c++){
		for (int i = 0; i < 4; i++){
			pinHigh(colPort[i], colBit[i]);
		}
		pinLow(colPort[c], colBit[c]);
		wait_ticks(50);
		for (int r = 0; r < 4; r++){
			if (!readPin(rowPort[r], rowBit[r])){
				found = keyMap[r][c];
			}
		}
		if (found){
			break;
		}
	}
	for (int i = 0; i < 4; i++){
		pinHigh(colPort[i], colBit[i]);
	}
	return found;
}

char getKey(void){
	char key;
	while (scanKey());
	wait_ticks(20000);
	while ((key = scanKey()) == 0);
	wait_ticks(20000);
	while (scanKey());
	wait_ticks(20000);
	return key;
}

