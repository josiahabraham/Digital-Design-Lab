void initialize(void){
	RCC_IOPENR |= RCC_IOPAEN | RCC_IOPBEN;

	for (int i = 0; i < 4; i++){
		setPullup(rowPort[i], rowBit[i]);
		setOutput(colPort[i], colBit[i]);
		pinHigh(colPort[i], colBit[i]);
	}

	setOutput(LED_RED_PORT, LED_RED_BIT);
	setOutput(LED_GREEN_PORT, LED_GREEN_BIT);

	setOutput(LCD_CS_PORT, LCD_CS_BIT);
	setOutput(LCD_RS_PORT, LCD_RS_BIT);
	setOutput(LCD_RST_PORT, LCD_RST_BIT);
	setAltFunc(GPIOA, 5); //SCK
	setAltFunc(GPIOA, 7); //MOSI

	spiInit();
	lcdInit();
}

int main(void){
	initialize();
	while (1){
		newGame();
		int player = 1;
		int winner = 0;
		while (!winner){
			setTurnLED(player);
			drawStatus(player);
			if (!hasAnyMove(player)){
				winner = (player == 1) ? 2 : 1;    //no legal moves=loss
				break;
			}
			playerTurn(player);
			int other = (player == 1) ? 2 : 1;
			if (countPieces(other) == 0){
				winner = player;
			}
			else{
				player = other;
			}
		}
		drawStatus(winner);
		showWinner(winner);
	}
}
